{
  "name": "@claude-agent-sdk/code-migration-assistant",
  "version": "1.0.0",
  "description": "Assist with code migrations between frameworks and versions",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
