{
  "name": "@claude-agent-sdk/cli",
  "version": "1.0.0",
  "description": "Unified CLI for Claude Agent SDK MCP servers",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "claude-agent": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "keywords": [
    "cli",
    "mcp",
    "claude",
    "agent",
    "development"
  ],
  "author": "Claude Agent SDK",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "figlet": "^1.7.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0-alpha.6",
    "@types/figlet": "^1.5.8",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "jest": "^30.0.0-alpha.6",
    "ts-jest": "^29.3.4",
    "typescript": "^5.3.3"
  }
}
